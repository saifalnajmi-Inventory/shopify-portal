{
  "name": "shopify-inventory-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma db push && next start -p ${PORT:-3001}",
    "start:prod": "prisma generate && prisma db push && node scripts/seed-admin.js --skip-if-exists && next start -p 3000",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@sentry/nextjs": "^10.55.0",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.395.0",
    "next": "^14.2.5",
    "node-fetch": "^3.3.2",
    "prisma": "^5.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.12.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  }
}
