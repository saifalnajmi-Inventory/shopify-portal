# ─── Shopify ───────────────────────────────────────────────────────────────────
# Your store domain WITHOUT https:// — e.g. my-store.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API access token from your private/custom app
# Settings → Apps and sales channels → Develop apps → Your App → API credentials
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite path (relative to project root). Change to postgresql://... for Postgres.
DATABASE_URL="file:./prisma/dev.db"

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Inventory Portal"
# Optional: simple password to protect the portal (add in middleware later)
ADMIN_PASSWORD=changeme
